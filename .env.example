# Puerto donde corre el dashboard local (opcional).
PORT=4173

# El agente siempre escucha solo en 127.0.0.1. No se configura HOST aquí.
# Las credenciales se ingresan en la UI y viven en memoria para la sesión.
# El proveedor seguro de credenciales persistidas se configura por el runtime,
# no en este archivo.

# Sync automático del catálogo (opcional, apagado si está vacío).
# Hora local a la que refrescar UN subject por noche — el que lleve más tiempo
# sin actualizarse. Elegí una hora fuera de pico: es la operación más pesada
# contra el portal. Nunca corre durante el pre-warm ni un disparo programado
# (ver src/cron.js); los watchers comparten la fila de servicio fuera del pico.
CATALOG_CRON_AT=
# Qué subjects rotar. Vacío = los de las materias que te faltan del pénsum.
CATALOG_CRON_SUBJECTS=

# Watcher de cupos compartido (L4). Una sola sesión de servicio consulta la
# unión de materias vigiladas; el presupuesto limita cuántas materias revisa
# cada tick. El ciclo que ve cada usuario es ceil(materias/presupuesto) × tick.
# WATCHER_INTERVAL_MS no baja de 30000 para no castigar el portal.
WATCHER_INTERVAL_MS=45000
WATCHER_SCRAPE_BUDGET=1

# El pre-warm de los disparos se reparte de T-8 a T-5 min por usuario.
# PREWARM_JITTER_MS=180000

# Web Push (VAPID) — L4. Sin estas llaves el canal de push queda apagado (el
# popup de escritorio sigue funcionando en local). Generá un par una sola vez:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La PÚBLICA se le entrega al navegador; la PRIVADA nunca sale del server.
MIKAMPUS_VAPID_PUBLIC=
MIKAMPUS_VAPID_PRIVATE=
# Identifica al remitente ante el push service (mailto: o la URL del sitio).
MIKAMPUS_VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Alerta de operador L4: después de 3 fallos seguidos del watcher o pre-warm,
# avisa por ntfy (canal independiente de Web Push). Vacío = solo se registra
# el aviso local; generá un topic privado antes del día-D.
MIKAMPUS_OPERATOR_NTFY_TOPIC=
# MIKAMPUS_OPERATOR_NTFY_URL=https://ntfy.sh
