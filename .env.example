# Credenciales del portal de autoservicio (PeopleSoft) de PUCMM.
# Copia este archivo como .env y nunca lo subas a un repo compartido.
# Sirven de bootstrap: una vez arriba, podés cambiar de cuenta desde Ajustes en
# la página (se guarda en data/account.json y esa cuenta pasa a mandar sobre lo
# que haya acá, sin reiniciar).
PUCMM_USERNAME=
PUCMM_PASSWORD=

# Puerto donde corre el dashboard local (opcional).
PORT=4173

# Interfaz donde escucha. Por defecto solo tu máquina (127.0.0.1).
# HOST=0.0.0.0 lo abre a tu red local para usarlo desde el teléfono: tus
# credenciales no salen de acá, pero cualquiera en el mismo WiFi puede abrirlo
# y usar tu sesión del portal (no hay login). Con criterio.
HOST=127.0.0.1

# Hosted (solo en la VM): usuarios invitados separados por coma. Dejarlo vacío
# bloquea todos los logins hosted; local no usa esta lista.
# MIKAMPUS_MODE=hosted
# MIKAMPUS_ALLOWLIST=elias,ana

# Clave hex de 32 bytes del almacén separado de credenciales persistidas.
# Solo hace falta para disparos/watchers desatendidos, nunca va al repo.
# MIKAMPUS_CRED_KEY=

# Sync automático del catálogo (opcional, apagado si está vacío).
# Hora local a la que refrescar UN subject por noche — el que lleve más tiempo
# sin actualizarse. Elegí una hora fuera de pico: es la operación más pesada
# contra el portal. Nunca corre si hay una inscripción programada o el watcher
# está prendido (ver src/cron.js).
CATALOG_CRON_AT=
# Qué subjects rotar. Vacío = los de las materias que te faltan del pénsum.
CATALOG_CRON_SUBJECTS=

# Web Push (VAPID) — L4. Sin estas llaves el canal de push queda apagado (el
# popup de escritorio sigue funcionando en local). Generá un par una sola vez:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La PÚBLICA se le entrega al navegador; la PRIVADA nunca sale del server.
MIKAMPUS_VAPID_PUBLIC=
MIKAMPUS_VAPID_PRIVATE=
# Identifica al remitente ante el push service (mailto: o la URL del sitio).
MIKAMPUS_VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
