[Unit]
Description=Sincroniza el aula virtual y sube a Kino lo que publico
Documentation=https://github.com/eliasdlc/mikampus/blob/dev/deploy/aula-a-kino/README.md

[Service]
Type=oneshot
# El secreto vive en un fichero de modo 600, nunca en la unidad: systemctl cat
# imprime la unidad entera y journalctl la cita cuando algo falla.
# El guion hace el fichero opcional: sin el, la unidad arrancaria y fallaria
# antes de llegar al comando, que ya sabe decir que esta apagado y salir con 0.
EnvironmentFile=-%h/.config/mikampus/aula-a-kino.env
# mikampus corre desde su checkout: no hay paquete instalado en esta maquina.
WorkingDirectory=%h/dev/projects/mikampus-better-solution
ExecStart=/usr/bin/node bin/mikampus.mjs aula-a-kino
# Sin esto un fallo de red de las 6 de la manana deja el barrido colgado hasta
# la vuelta siguiente, que son seis horas de tareas que no existen.
TimeoutStartSec=10min
