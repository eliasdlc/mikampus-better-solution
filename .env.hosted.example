# Dominio que ya apunta a la IPv4 pública del Droplet. Caddy emite TLS solo
# cuando este A record está propagado y los puertos 80/443 están abiertos.
DOMAIN=mikampus.decruce.dev

# Basic Auth PROVISIONAL del piloto single-user. Generá el hash con:
# docker compose run --rm caddy caddy hash-password --plaintext 'una-frase-larga'
# Al pegarlo, envuelve el hash completo en comillas simples para que Compose no
# interprete sus signos $.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD_HASH=

# Credenciales de PeopleSoft: solo en este archivo local del Droplet, nunca en git.
PUCMM_USERNAME=
PUCMM_PASSWORD=

# El contenedor siempre usa esta zona; no depende de la región del Droplet.
TZ=America/Santo_Domingo

# Copias locales consistentes de SQLite: tres días mientras Litestream replica
# al bucket. No sustituye la réplica remota.
MIKAMPUS_BACKUP_AT=03:30
MIKAMPUS_BACKUP_KEEP=3

# Litestream se deja apagado hasta crear un bucket privado y sus access keys.
# Al activarlo, la réplica remota retiene exactamente 72 horas.
LITESTREAM_ENABLED=false
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_AGE_RECIPIENT=
